<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Career Lens · {{ intake.target.sub_role }}</title>
<style>
:root{--ink:#183149;--muted:#536577;--blue:#2673d9;--orange:#a94f08;--line:#dde5ee;--paper:#fff;--background:#f4f6f9}
*{box-sizing:border-box}body{margin:0;background:var(--background);color:var(--ink);font:16px/1.75 -apple-system,BlinkMacSystemFont,"PingFang SC","Noto Sans CJK SC",sans-serif}main{max-width:860px;margin:32px auto;background:var(--paper);padding:40px 48px}h1{font-size:27px;line-height:1.4;margin:8px 0 20px}h2{font-size:24px;line-height:1.5;margin:0 0 24px}h3{font-size:18px;line-height:1.5;margin:0 0 8px}p{margin:0 0 16px}.brand{font-size:13px;letter-spacing:2px;color:var(--blue);font-weight:650}.meta,.scope{font-size:13px;color:var(--muted)}.headline{font-size:23px;font-weight:650;line-height:1.6}section{padding:28px 0;border-top:1px solid var(--line)}.chart{display:block;width:390px;max-width:100%;height:auto;margin:0 auto 24px}.finding{border-left:3px solid var(--blue);padding:0 0 0 16px;margin:20px 0}.finding.obstacle{border-color:var(--orange)}.finding p{margin:0}.difference{margin-bottom:30px}.task{margin:24px 0 32px}dl{margin:0}dt{font-weight:650;margin-top:12px}dd{margin:4px 0 12px}.sources{font-size:13px}a{color:#1e5a9e;text-underline-offset:3px;overflow-wrap:anywhere}a:focus-visible{outline:3px solid var(--blue);outline-offset:3px}footer{border-top:1px solid var(--line);padding-top:24px;font-size:14px}.scope{padding:12px 16px;background:#f4f7fb}img{max-width:100%}.synthetic{color:#91400a;font-weight:650}@media(max-width:600px){main{margin:0;padding:24px 20px}h1{font-size:23px}.headline{font-size:21px}h2{font-size:21px}}@media print{body{background:#fff}main{margin:0;padding:0}section{break-before:page;border:0}.positioning{break-before:auto}.chart{width:290px}.finding,.difference,.task{break-inside:avoid}footer{font-size:11px}} 
</style></head><body><main>
<header><p class="brand">CAREER LENS</p><h1>{{ intake.target.sub_role }}</h1><p class="meta">{{ intake.target.location }} · {{ intake.target.seniority }} · {{ intake.target.as_of }}</p>{% if synthetic %}<p class="synthetic">合成演示：岗位、个人经历与评分为虚构数据。</p>{% endif %}</header>
<section class="positioning"><h2>01 / {{ "你的定位" if personal_available else "岗位理解" }}</h2><p class="headline">{{ report_content.headline }}</p>
{% if chart_path %}<img class="chart" src="{{ chart_path }}" alt="{{ chart_alt }}">{% else %}<p>{{ chart_note }}</p>{% endif %}
<p class="scope">{{ report_content.scope_summary }}</p>
{% for f in report_content.findings %}<article class="finding {{ f.kind }}"><h3>{{ f.title }}</h3><p>{{ f.text }}</p><p class="sources">岗位依据：{% for sid in f.source_ids %}<a href="{{ source_map[sid].url or evidence_html_filename }}">{{ source_map[sid].organization }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p></article>{% endfor %}
</section>
<section><h2>02 / {{ "最值得关注的差异" if personal_available else "核心任务与责任" }}</h2>{% for d in report_content.differences %}<article class="difference"><h3>{{ d.title }}</h3><dl><dt>岗位任务</dt><dd>{{ d.market_requirement }}</dd><dt>{{ "你的经历" if personal_available else "材料范围" }}</dt><dd>{{ d.personal_evidence }}</dd><dt>{{ "对你的影响" if personal_available else "理解与应用" }}</dt><dd>{{ d.implication }}</dd></dl><p class="sources">{% for sid in d.source_ids %}<a href="{{ source_map[sid].url or evidence_html_filename }}">{{ source_map[sid].organization }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p></article>{% endfor %}</section>
<section><h2>03 / 接下来先做这{{ report_content.actions|length }}件事</h2>{% for a in report_content.actions %}<article class="task"><h3>{{ loop.index }}. {{ a.why }}</h3><dl><dt>具体任务</dt><dd>{{ a.task }}</dd><dt>产出</dt><dd>{{ a.deliverable }}</dd><dt>完成条件</dt><dd>{{ a.check }}</dd><dt>顺序与周期</dt><dd>{{ a.period }}</dd></dl></article>{% endfor %}</section>
<footer><a href="{{ evidence_html_filename }}">查看研究与判断依据</a> · <a href="{{ markdown_filename }}">Markdown版本</a>{% if pdf_filename %} · <a href="{{ pdf_filename }}">下载PDF</a>{% endif %}</footer>
</main></body></html>
